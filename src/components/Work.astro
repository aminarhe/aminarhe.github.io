---
import Prompt from './Prompt.astro';
import Stack from './Stack.astro';
import { work } from '../data/work';
---

<section id="work">
  <Prompt cmd="cat work.md" />
  <div class="out md">
    {
      work.map((entry) => (
        <>
          <h3>{entry.company}</h3>
          {entry.when && <p class="when">{entry.when}</p>}
          {entry.summary && <p>{entry.summary}</p>}
          {entry.stack && <Stack items={entry.stack} />}
          {entry.more && (
            <details>
              <summary>more</summary>
              <ul>
                {entry.more.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </details>
          )}
          {entry.roles?.map((role) => (
            <>
              <h4>
                {role.title}{' '}
                {role.when && <span class="when">{role.when}</span>}
              </h4>
              <p>{role.summary}</p>
              {role.stack && <Stack items={role.stack} />}
              {role.more && (
                <details>
                  <summary>more</summary>
                  <ul>
                    {role.more.map((item) => (
                      <li>{item}</li>
                    ))}
                  </ul>
                </details>
              )}
            </>
          ))}
        </>
      ))
    }
  </div>
</section>
