---
import Prompt from './Prompt.astro';
import { research } from '../data/research';
---

<section id="research">
  <Prompt cmd="cat research/*.md" />
  <div class="out md">
    {
      research.map((r) => (
        <>
          <h3>{r.title}</h3>
          {r.with && <p class="when">{r.with}</p>}
          <p>{r.body}</p>
        </>
      ))
    }
  </div>
</section>
