---
import { getCollection, render } from 'astro:content';
import Prompt from './Prompt.astro';
import PhotoSlot from './PhotoSlot.astro';
import Stack from './Stack.astro';
import { projectCover, projectPhotos } from '../lib/photos';

const entries = (await getCollection('projects')).sort(
  (a, b) => a.data.order - b.data.order,
);

const projects = await Promise.all(
  entries.map(async (entry) => {
    const { Content } = await render(entry);
    const dir = entry.data.photoDir ?? entry.id;
    const photos = projectPhotos(dir);
    const cells = photos.map((photo) => ({ photo, label: photo.file }));
    // The [+] photos toggle only appears when there is something inside it:
    // gallery photos, or extra text written below the project's frontmatter.
    const hasMore = photos.length > 0 || Boolean(entry.body?.trim());
    return {
      id: entry.id,
      data: entry.data,
      Content,
      cover: projectCover(dir),
      cells,
      hasMore,
    };
  }),
);
---

<section id="projects">
  <Prompt cmd="ls Projects/" />
  <div class="out">
    <div class="ls">
      {projects.map((p) => <a href={`#${p.id}`}>{p.id}/</a>)}
    </div>
  </div>
  <div class="out md">
    {
      projects.map((p) => {
        const { Content } = p;
        return (
        <article class="proj" id={p.id}>
          <PhotoSlot
            photo={p.cover}
            label="cover.jpg"
            caption={p.cover && p.data.captions[p.cover.file]}
            width={260}
          />
          <div class="blk">
            <h3>{p.data.title}</h3>
            {p.data.where && <p class="where">{p.data.where}</p>}
            <p>{p.data.summary}</p>
            {p.data.stack.length > 0 && <Stack items={p.data.stack} />}
            {p.data.links.length > 0 && (
              <p class="links">
                <span class="label">links:</span>{' '}
                {p.data.links.map((link, i) => (
                  <>
                    {i > 0 && <>&nbsp;&nbsp;</>}
                    <a href={link.url}>{link.label}</a>
                  </>
                ))}
              </p>
            )}
            {p.hasMore && (
            <details>
              <summary>photos</summary>
              <Content />
              <div class="gallery">
                {p.cells.map((cell) => (
                  <PhotoSlot
                    photo={cell.photo}
                    label={cell.label}
                    caption={cell.photo && p.data.captions[cell.photo.file]}
                    width={520}
                  />
                ))}
              </div>
            </details>
            )}
          </div>
        </article>
        );
      })
    }
  </div>
</section>
